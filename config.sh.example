#!/bin/bash
# Copy this file to config.sh and edit the paths for your own system.
export PROJECT_ROOT="/path/to/StrepA_project_revamped"
export DATA_DIR="$PROJECT_ROOT/data"
export RESULTS_DIR="$PROJECT_ROOT/results"
export GFF_DIR="$PROJECT_ROOT/converted_gffs"
export REMOVED_GFF_DIR="$PROJECT_ROOT/removed_gffs"
export METADATA_FILE="$PROJECT_ROOT/StrepA_Project_Revamped_metadata.tsv"
export MASH_DB="/path/to/your/mash_database.msh"
export PANAROO_RESULTS_DIR="$PROJECT_ROOT/panaroo_results"
export ALIGNMENT_ENV="/path/to/your/conda/envs/alignment_env"
export RAXML_RESULTS_DIR="$PROJECT_ROOT/raxml_results"
export POSTPANAROO_INPUT_DIR="$PROJECT_ROOT/converted_gffs_copy/converted_gffs"
export PANAROO_CONDA_ENV="/path/to/your/conda/envs/panaroo"
export COREKABURRA_ENV="/path/to/your/conda/envs/corekaburra_env"
export POSTPANAROO_GFFS_DIR="$PROJECT_ROOT/panaroo_results/postpanaroo_gffs_2"
export COREKABURRA_RESULTS_DIR="$PROJECT_ROOT/corekaburra_results_2"
